datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPPORT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PlanTier {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum Currency {
  EGP
  SAR
  USD
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}

enum ReservationStatus {
  PENDING
  SETTLED
  RELEASED
}

enum LedgerTransactionType {
  TRIAL_GRANT
  SUBSCRIPTION_GRANT
  TOP_UP_PURCHASE
  JOB_SETTLEMENT
  JOB_REFUND
  ADMIN_ADJUSTMENT
  REFUND_REVERSAL
}

enum AuthActionTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  name              String?
  phone             String?
  passwordHash      String?
  role              Role        @default(USER)
  country           String      @default("EG") // EG or SA
  locale            String      @default("ar") // ar or en
  emailVerifiedAt   DateTime?
  trialGrantedAt    DateTime?
  passwordUpdatedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workspaces      WorkspaceMember[]
  sessions        Session[]
  auditLogs       AdminAuditLog[]
  actionTokens    AuthActionToken[]
  sentInvites       WorkspaceInvite[]       @relation("InviteSender")
  acceptedInvites   WorkspaceInvite[]       @relation("InviteAccepter")
  inviteRedemptions BetaInviteRedemption[]
  imageFeedbacks    ImageFeedback[]
}

model Workspace {
  id            String            @id @default(uuid())
  name          String
  slug          String            @unique
  ownerId       String
  country       String            @default("EG")
  currency      Currency          @default(EGP)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  members       WorkspaceMember[]
  activeSessions Session[]
  brands        Brand[]
  photoshoots   Photoshoot[]
  subscription  Subscription?
  creditLedgers CreditLedger[]
  reservations  CreditReservation[]
  transactions  PaymentTransaction[]
  invites       WorkspaceInvite[]
  imageFeedbacks ImageFeedback[]
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Session {
  id                String     @id @default(uuid())
  userId            String
  activeWorkspaceId String?
  tokenHash         String     @unique
  csrfToken         String
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime   @default(now())
  lastActivityAt    DateTime   @default(now())
  idleExpiresAt     DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace   Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model Brand {
  id           String        @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  aesthetic    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id          String         @id @default(uuid())
  brandId     String
  name        String
  category    String
  description String?
  dimensions  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  assets      ProductAsset[]
  photoshoots Photoshoot[]
}

model ProductAsset {
  id          String     @id @default(uuid())
  productId   String
  rawUrl      String
  maskedUrl   String?
  maskUrl     String?
  width       Int
  height      Int
  fileSize    Int
  createdAt   DateTime   @default(now())

  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id           String          @id @default(uuid())
  name         String
  nameAr       String
  category     String
  thumbnailUrl String?
  isRegional   Boolean         @default(false)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  versions     PromptVersion[]
}

model PromptVersion {
  id          String         @id @default(uuid())
  templateId  String
  version     Int            @default(1)
  basePrompt  String         @db.Text
  negPrompt   String?        @db.Text
  modelTarget String         @default("gemini-3.1-flash-image")
  isCurrent   Boolean        @default(true)
  createdAt   DateTime       @default(now())

  template    PromptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  jobs        GenerationJob[]
}

model Photoshoot {
  id          String          @id @default(uuid())
  workspaceId String
  productId   String
  title       String
  stylePreset String
  aspectRatio String          @default("1:1") // 1:1, 4:5, 9:16, 16:9
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  jobs        GenerationJob[]
}

model GenerationJob {
  id                String             @id @default(uuid())
  photoshootId      String
  promptVersionId   String?
  status            JobStatus          @default(QUEUED)
  modelUsed         String
  creditCost        Int                @default(1)
  rawPrompt         String             @db.Text
  synthesizedPrompt String             @db.Text
  errorMessage      String?
  lastErrorCode     String?
  attempts          Int                @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  heartbeatAt       DateTime?
  idempotencyKey    String?            @unique
  assetKey          String?
  inputTokens       Int?
  outputTokens      Int?
  thoughtTokens     Int?
  costUsdMicros     Int?
  createdAt         DateTime           @default(now())

  photoshoot        Photoshoot         @relation(fields: [photoshootId], references: [id], onDelete: Cascade)
  promptVersion     PromptVersion?     @relation(fields: [promptVersionId], references: [id])
  images            GeneratedImage[]
  reservation       CreditReservation?
}

model GeneratedImage {
  id              String        @id @default(uuid())
  generationJobId String
  imageUrl        String
  thumbnailUrl    String?
  resolution      String        @default("1024x1024")
  aspectRatio     String        @default("1:1")
  seed            BigInt?
  isFavorite      Boolean       @default(false)
  synthIdDetected Boolean       @default(false)
  fidelityScore   Float         @default(1.0)
  executionMode   String        @default("LIVE_GEMINI_API")
  createdAt       DateTime      @default(now())

  generationJob   GenerationJob   @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  feedbacks       ImageFeedback[]
}

model Subscription {
  id                   String             @id @default(uuid())
  workspaceId          String             @unique
  planTier             PlanTier           @default(FREE)
  status               SubscriptionStatus @default(INCOMPLETE)
  currency             Currency           @default(EGP)
  monthlyCredits       Int                @default(5)
  paymobSubscriptionId String?            @unique
  paymobCardToken      String?
  region               String             @default("EG")
  paymobPlanId         String?
  lastRenewalAt        DateTime?
  failedAttempts       Int                @default(0)
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id             String                @id @default(uuid())
  workspaceId    String
  amount         Int
  balanceAfter   Int
  type           LedgerTransactionType
  referenceId    String?
  idempotencyKey String?               @unique
  description    String?
  createdAt      DateTime              @default(now())

  workspace    Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model CreditReservation {
  id              String            @id @default(uuid())
  workspaceId     String
  generationJobId String            @unique
  amount          Int
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  settledAt       DateTime?

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generationJob   GenerationJob     @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id               String    @id @default(uuid())
  workspaceId      String
  amountCents      Int
  currency         Currency
  kind             String    @default("TOP_UP")
  planTier         PlanTier?
  packId           String?
  credits          Int       @default(0)
  region           String    @default("EG")
  paymobOrderId    String?   @unique
  paymobTxnId      String?   @unique
  intentionId      String?   @unique
  specialReference String?   @unique
  paymentMethod    String?
  status           String
  errorMessage     String?
  createdAt        DateTime  @default(now())

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String    @id @default(uuid())
  source      String    @default("PAYMOB")
  eventId     String    @unique
  payloadHash String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  errorMessage String?
  createdAt   DateTime  @default(now())

  @@index([source, eventId])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  targetId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthActionToken {
  id          String              @id @default(uuid())
  userId      String
  type        AuthActionTokenType
  tokenHash   String              @unique
  targetEmail String?
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdIp   String?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime
  updatedAt   DateTime

  @@index([expiresAt])
}

model WorkspaceInvite {
  id               String        @id @default(uuid())
  workspaceId      String
  invitedEmail     String
  role             WorkspaceRole
  invitedByUserId  String
  tokenHash        String        @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy        User          @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?         @relation("InviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, invitedEmail])
  @@index([expiresAt])
}

model BetaInviteCode {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  redemptions BetaInviteRedemption[]
}

model BetaInviteRedemption {
  id           String         @id @default(uuid())
  inviteCodeId String
  userId       String
  redeemedAt   DateTime       @default(now())

  inviteCode   BetaInviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId])
  @@index([userId])
}

model ImageFeedback {
  id               String         @id @default(uuid())
  generatedImageId String
  workspaceId      String
  userId           String
  rating           String         // THUMBS_UP or THUMBS_DOWN
  reason           String?        // POOR_LIGHTING, BLURRY_FOREGROUND, HALLUCINATED_TEXT, STYLE_MISMATCH, OTHER
  comment          String?
  createdAt        DateTime       @default(now())

  generatedImage   GeneratedImage @relation(fields: [generatedImageId], references: [id], onDelete: Cascade)
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([generatedImageId])
  @@index([workspaceId])
}
