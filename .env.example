# Application Core
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Shotistry"
NODE_ENV="development"

# Database Persistence (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shotistry?schema=public"

# Authentication & Session Security
NEXTAUTH_SECRET="your-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini / Imagen AI Engine (@google/genai)
GEMINI_API_KEY="AIzaSyPlaceholderGeminiApiKey"

# Paymob Payment Gateway
PAYMOB_API_KEY="sec_test_placeholder"
PAYMOB_PUBLIC_KEY="pk_test_placeholder"
PAYMOB_HMAC_SECRET="placeholder_hmac_secret_sha512"
PAYMOB_EG_INTEGRATION_ID="12345"
PAYMOB_SA_INTEGRATION_ID="67890"

# Object Storage (Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT="https://placeholder-account.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="placeholder_access_key"
STORAGE_SECRET_ACCESS_KEY="placeholder_secret_key"
STORAGE_BUCKET_NAME="shotistry-assets"
NEXT_PUBLIC_CDN_URL="https://cdn.shotistry.com"

# Rate Limiting & Abuse Prevention (Distributed)
# Primary production recommendation: Upstash Redis REST
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
# Optional overrides: 'upstash' | 'postgres' | 'memory' ('memory' forbidden in production)
SHOTISTRY_RATE_LIMIT_BACKEND="upstash"
# Number of trusted reverse proxies when inspecting X-Forwarded-For (default 0: rightmost non-private)
SHOTISTRY_TRUSTED_PROXY_COUNT="1"

# Password Hashing Concurrency & Safety
SHOTISTRY_MAX_CONCURRENT_HASHES="4"

# Transactional Email Delivery (Resend)
APP_BASE_URL="http://localhost:3000"
RESEND_API_KEY="re_placeholder_api_key"
EMAIL_FROM="Shotistry <no-reply@mail.shotistry.com>"
EMAIL_REPLY_TO="support@shotistry.com"
